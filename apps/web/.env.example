# Base URL of the NestJS API (include the /api global prefix).
NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# --- Auth (NextAuth / Azure AD) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-32-character-secret-here"
# From the Azure AD (Entra ID) app registration shared by the client.
AUTH_MICROSOFT_ENTRA_ID_ID="<app-registration-client-id>"
AUTH_MICROSOFT_ENTRA_ID_SECRET="<client-secret>"
# Restricts sign-in to the org's tenant. Format: https://login.microsoftonline.com/<tenant-id>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<tenant-id>/v2.0"
AUTH_URL="https://<your-domain>"

# Server-only URL for web→api calls during the NextAuth login/refresh
# handshake (never exposed to the client bundle). Same origin as
# NEXT_PUBLIC_API_URL in this repo's dev/deploy setup.
API_INTERNAL_URL="http://localhost:3001/api"
