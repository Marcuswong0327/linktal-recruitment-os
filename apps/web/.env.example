# Base URL of the NestJS API (include the /api global prefix).
NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Neon Auth ---
# Get this from Neon Console → Your Project → Auth tab
NEON_AUTH_BASE_URL="https://ep-xxxx.neonauth.region.aws.neon.tech"
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET="your-32-character-secret-here"
