// =============================================================================
// CLIENT JOB RESEARCH (Historical/prospecting job openings)
// =============================================================================

model ClientJobResearch {
  id              String    @id @default(cuid())
  clientId        String

  jobTitle        String
  jobDescription  String?
  salaryRange     String?
  location        String?
  sourceUrl       String?   // URL where job was found (Seek, LinkedIn, etc.)
  sourceType      String?   // Seek, LinkedIn, Company Website, etc.

  status          String    @default("Prospect") // Prospect, Contacted, Converted, Closed
  notes           String?

  // Relations
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  jobOrders       JobOrder[] // Jobs that were created from this research

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([clientId])
  @@index([status])
}

// =============================================================================
// CANDIDATE (Job seekers)
// =============================================================================

model Candidate {
  id                String          @id @default(cuid())
  displayId         String          @unique  // Format: "CDD-XXXX"

  // Personal info
  fullName          String
  givenName         String?
  familyName        String?
  email             String?
  mobile            String?
  linkedInUrl       String?
  seekTalentUrl     String?

  // Location
  country           String?
  city              String?
  suburb            String?

  // Professional info
  industry          String?         // Free text (custom allowed)
  roleType          String?         // Free text (custom allowed)
  currentPosition   String?         // Free text (custom allowed)
  specializations   Json?           // String[] - flexible array
  workHistory       Json?           // Array of {company, role, startDate, endDate}

  // Resume
  rawResumeUrl      String?
  editedResumeUrl   String?

  // Status & tracking
  status            CandidateStatus @default(COLD)
  contactedBy       String?         // Consultant name or ID
  lastScreenedAt    DateTime?
  placedAt          DateTime?

  // Relations
  consultantId      String?
  consultant        Consultant?     @relation(fields: [consultantId], references: [id])
  screeningHistory  CandidateScreeningHistory[]
  submissions       CandidateSubmission[]

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([displayId])
  @@index([status])
  @@index([industry])
  @@index([consultantId])
}

model CandidateScreeningHistory {
  id           String     @id @default(cuid())
  candidateId  String

  screenedAt   DateTime   @default(now())
  screenedBy   String?    // Consultant name or ID
  notes        Json?      // Array of {text, createdAt}
  outcome      String?    // Qualified, Not Qualified, Follow Up, etc.

  // Screening details
  salaryExpectation     Decimal?   @db.Decimal(12, 2)
  noticePeriod          String?
  availableFrom         DateTime?
  willingToRelocate     Boolean?

  // Relations
  candidate    Candidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  consultantId String?
  consultant   Consultant? @relation(fields: [consultantId], references: [id])

  createdAt    DateTime   @default(now())

  @@index([candidateId])
  @@index([screenedAt])
}

