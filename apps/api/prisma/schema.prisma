// Prisma schema — https://pris.ly/d/prisma-schema
// Datasource: PostgreSQL on Neon (auth is handled by NextAuth + Azure AD, not Neon)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pg_trgm]
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ClientStatus {
  COLD
  WARM
  TRADED
}

// Declaration order matters: Postgres native enums sort by declaration
// (ordinal) order, not alphabetically, so this order is what makes
// `ORDER BY quality` come out as LOW < MEDIUM < HIGH.
enum ClientQuality {
  LOW
  MEDIUM
  HIGH
}

enum CandidateStatus {
  COLD
  WARM
  HOT
  PLACED
}

enum JobOrderStatus {
  ACTIVE
  PLACED
  CLOSED
  ON_HOLD
}

// Same declaration-order trick as ClientQuality (see its comment above) —
// LOW < MEDIUM < HIGH lets `ORDER BY quality` come out meaningfully sorted.
enum JobOrderQuality {
  LOW
  MEDIUM
  HIGH
}

enum SubmissionStatus {
  SUBMITTED
  INTERVIEWING
  REJECTED
  PLACED
}

enum PlacementStatus {
  ACTIVE
  COMPLETED
  FAILED
}

enum PlacementFeeType {
  PERCENTAGE
  FLAT
}

enum InterviewOutcome {
  SCHEDULED
  PENDING
  PASSED
  FAILED
  CANCELLED
}

// ============================================================================
// RBAC TABLES
// ============================================================================

model Role {
  id          String           @id @default(cuid())
  name        String           @unique // admin, manager, consultant, finance, researcher, viewer
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  consultants Consultant[]
}

model Permission {
  id          String           @id @default(cuid())
  resource    String // candidates, clients, jobOrders, etc.
  action      String // create, read, update, delete
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]

  @@unique([resource, action])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

// ============================================================================
// CONSULTANT (Recruiter profile)
// ============================================================================

model Consultant {
  id           String     @id @default(cuid())
  displayId    String     @unique @default(dbgenerated("('consultant-'::text || lpad((nextval('\"Consultant_displayId_seq\"'::regclass))::text, 4, '0'::text))")) // Auto: consultant-####
  azureId      String?    @unique // Azure AD object id (oid claim)
  passwordHash String? // bcrypt hash; set when the consultant has email+password auth enabled
  email        String     @unique
  fullName     String
  roleId       String?
  role         Role?      @relation(fields: [roleId], references: [id])
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  clients      Client[]
  jobOrders    JobOrder[]
  candidates   Candidate[]
  stakeholderContacts StakeholderContactHistory[]
  candidateContacts   CandidateContactHistory[]
  candidateSavedSearches CandidateSavedSearch[]
}

// ============================================================================
// CLIENT (Companies hiring)
// ============================================================================

// Reference table for Client.industry — a fixed row instead of free text, so
// values stay consistent and reusable. No admin management page: the company
// form's combobox doubles as the catalog editor (pick existing or type new,
// which creates a row here). isActive isn't surfaced anywhere yet — it's
// forward-looking, for when hiding one from the picker without deleting it
// (and orphaning clients that reference it) becomes a real need.
model Industry {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clients    Client[]
  candidates Candidate[] // Shared taxonomy: same catalog Client.industry uses.
}

// Same as Industry, for Client.specialization. Also shared by Candidate, but
// as a many-to-many (a candidate can carry several specializations, unlike
// Client's single specializationId) via the CandidateSpecialization join.
model Specialization {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clients                  Client[]
  candidateSpecializations CandidateSpecialization[]
}

model Client {
  id               String              @id @default(cuid())
  displayId        String              @unique @default(dbgenerated("('Client-'::text || lpad((nextval('\"Client_displayId_seq\"'::regclass))::text, 4, '0'::text))")) // Auto: Client-####
  companyName      String
  industryId       String?
  industry         Industry?           @relation(fields: [industryId], references: [id], onDelete: SetNull)
  specializationId String?
  specialization   Specialization?     @relation(fields: [specializationId], references: [id], onDelete: SetNull)
  country          String?
  city             String?
  website          String?
  tobSigned        Boolean             @default(false) // Terms of Business signed
  feePercentage    Float? // Fee as percentage of package (null until agreed)
  guaranteePeriod  Int                 @default(90) // Guarantee period in days
  status           ClientStatus        @default(COLD)
  quality          ClientQuality       @default(MEDIUM)
  notes            Json? // JSONB: [{id, content, timestamp, by, editedAt, editedBy}] — internal note timeline, newest last; edit/delete restricted to the note's author (or an admin)
  lastContactedAt  DateTime? // Denormalized: max(StakeholderContactHistory.contactedAt) across this client's stakeholders. Lets the list sort by it without a cross-table aggregate on every page load; source of truth stays StakeholderContactHistory.
  consultantId     String?
  consultant       Consultant?         @relation(fields: [consultantId], references: [id])
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  deletedAt        DateTime? // Soft delete: null = live
  deletedById      String? // Logical ref to Consultant.id (no FK)
  stakeholders     Stakeholder[]
  jobResearch      ClientJobResearch[]
  jobOrders        JobOrder[]

  @@index([status])
  @@index([consultantId])
  @@index([deletedAt])
  @@index([industryId])
  @@index([specializationId])
  @@index([lastContactedAt])
  @@index([quality])
}

// ============================================================================
// STAKEHOLDER (Contacts at client companies)
// ============================================================================

// Reference table for Stakeholder.roleType — same pattern as Industry/
// Specialization: a fixed row instead of a hardcoded enum, so the category
// list can grow (a new job-title category typed into the combobox creates a
// row here) without a migration. Seeded with a starting set (Director,
// Hiring Manager, HR, Talent Acquisition, Operations, Finance, Department
// Head, Other) and backfilled onto existing stakeholders by keyword-matching
// their current jobTitle (see scripts/backfill-stakeholder-role-types.ts).
model StakeholderRoleType {
  id           String        @id @default(cuid())
  name         String        @unique
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  stakeholders Stakeholder[]
}

model Stakeholder {
  id              String                      @id @default(cuid())
  displayId       String                      @unique @default(dbgenerated("('Stake-'::text || lpad((nextval('\"Stakeholder_displayId_seq\"'::regclass))::text, 4, '0'::text))")) // Auto: Stake-####
  clientId        String
  client          Client                      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fullName        String
  jobTitle        String?
  roleTypeId      String? // Derived from jobTitle by default (see backfill script), but independently editable — corrects a bad auto-classification without rewriting the person's actual title.
  roleType        StakeholderRoleType?        @relation(fields: [roleTypeId], references: [id], onDelete: SetNull)
  email           String?
  mobile          String?
  isDecisionMaker Boolean                     @default(false)
  notes           String?
  lastContactedAt DateTime? // Denormalized: max(StakeholderContactHistory.contactedAt) for this stakeholder. Prisma's relation-aggregate `orderBy` only supports `_count` (not `_max`) on to-many relations, so — same reasoning as Client.lastContactedAt — sorting needs a real column, not a live join, even though this is only one hop away.
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  deletedAt       DateTime? // Soft delete: null = live
  deletedById     String? // Logical ref to Consultant.id (no FK)
  contactHistory  StakeholderContactHistory[]

  @@index([clientId])
  @@index([deletedAt])
  @@index([roleTypeId])
  @@index([lastContactedAt])
}

model StakeholderContactHistory {
  id            String      @id @default(cuid())
  stakeholderId String
  stakeholder   Stakeholder @relation(fields: [stakeholderId], references: [id], onDelete: Cascade)
  contactType   String // email, call, meeting, linkedin
  contactedById String? // Consultant who made this specific contact — distinct from Client.consultantId (the account owner); any consultant can log a contact.
  contactedBy   Consultant? @relation(fields: [contactedById], references: [id], onDelete: SetNull)
  notes         String?
  contactedAt   DateTime    @default(now())
  createdAt     DateTime    @default(now())

  @@index([stakeholderId])
  @@index([contactedById])
}

// ============================================================================
// CLIENT JOB RESEARCH (Job openings research)
// ============================================================================

model ClientJobResearch {
  id           String    @id @default(cuid())
  clientId     String
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  jobTitle     String
  sourceUrl    String?
  salaryRange  String?
  notes        String?
  isContacted  Boolean   @default(false)
  researchedAt DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime? // Soft delete: null = live
  deletedById  String? // Logical ref to Consultant.id (no FK)

  @@index([clientId])
  @@index([deletedAt])
}

// ============================================================================
// CANDIDATE (Job seekers)
// ============================================================================

// Reference table for Candidate.roleType — same pattern as Industry/
// Specialization/StakeholderRoleType: a fixed row instead of free text, kept
// as its own catalog rather than reusing StakeholderRoleType, since a
// candidate's role type is an employment category (e.g. Permanent/Contract),
// not the functional/department classification stakeholders use.
model CandidateRoleType {
  id         String      @id @default(cuid())
  name       String      @unique
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  candidates Candidate[]
}

model Candidate {
  id                String                      @id @default(cuid())
  displayId         String                      @unique @default(dbgenerated("('CDD-'::text || lpad((nextval('\"Candidate_displayId_seq\"'::regclass))::text, 4, '0'::text))")) // Auto: CDD-####
  fullName          String
  givenName         String?
  familyName        String?
  email             String?
  mobile            String?
  country           String?
  city              String?
  industryId        String?
  industry          Industry?                   @relation(fields: [industryId], references: [id], onDelete: SetNull)
  roleTypeId        String?
  roleType          CandidateRoleType?          @relation(fields: [roleTypeId], references: [id], onDelete: SetNull)
  currentPosition   String?
  currentCompany    String?
  yearsExperience   Int?
  salaryExpectation String?
  linkedinUrl       String?
  resumeUrl         String?
  workHistory       Json? // JSONB: [{company, role, startDate, endDate}]
  skills            Json? // JSONB: ["string"] — free-entry tags, distinct from specializations (a shared, reference-table taxonomy).
  status            CandidateStatus             @default(COLD)
  notes             Json? // JSONB: [{id, content, timestamp, by, editedAt, editedBy}] — internal note timeline, newest last; edit/delete restricted to the note's author (or an admin). Mirrors Client.notes.
  consultantId      String? // Owning consultant — same shape as Client.consultantId, distinct from CandidateContactHistory.contactedById (who actually made a given contact).
  consultant        Consultant?                 @relation(fields: [consultantId], references: [id])
  lastContactedAt   DateTime? // Denormalized: max(CandidateContactHistory.contactedAt). Same reasoning as Client/Stakeholder.lastContactedAt — sorting needs a real column, not a live aggregate join.
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  deletedAt         DateTime? // Soft delete: null = live
  deletedById       String? // Logical ref to Consultant.id (no FK)
  screeningHistory  CandidateScreeningHistory[]
  contactHistory    CandidateContactHistory[]
  submissions       CandidateSubmission[]
  specializations   CandidateSpecialization[]

  @@index([status])
  @@index([email])
  @@index([deletedAt])
  @@index([consultantId])
  @@index([lastContactedAt])
  @@index([industryId])
  @@index([roleTypeId])
  // Trigram indexes back the quick-search's ILIKE/`contains` filters — turns
  // a substring scan on these columns into an index scan instead of a
  // sequential one, which is what keeps search fast as the candidate pool
  // grows (see 20260719021500_candidate_search_trigram_indexes).
  @@index([fullName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Candidate_fullName_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "Candidate_email_trgm_idx")
  @@index([currentPosition(ops: raw("gin_trgm_ops"))], type: Gin, map: "Candidate_currentPosition_trgm_idx")
  @@index([currentCompany(ops: raw("gin_trgm_ops"))], type: Gin, map: "Candidate_currentCompany_trgm_idx")
  @@index([city(ops: raw("gin_trgm_ops"))], type: Gin, map: "Candidate_city_trgm_idx")
  @@index([country(ops: raw("gin_trgm_ops"))], type: Gin, map: "Candidate_country_trgm_idx")
  @@index([mobile(ops: raw("gin_trgm_ops"))], type: Gin, map: "Candidate_mobile_trgm_idx")
  @@index([displayId(ops: raw("gin_trgm_ops"))], type: Gin, map: "Candidate_displayId_trgm_idx")
}

// Many-to-many join: a candidate can carry several specializations (unlike
// Client, which has a single specializationId). Explicit join model rather
// than an implicit Prisma m2m so the backfill migration can write to a named
// table directly.
model CandidateSpecialization {
  candidateId      String
  candidate        Candidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  specializationId String
  specialization   Specialization @relation(fields: [specializationId], references: [id], onDelete: Cascade)

  @@id([candidateId, specializationId])
  @@index([specializationId])
}

// A consultant's saved candidate search — the filter state is opaque JSON
// (same shape as QueryCandidatesDto's filter fields) rather than individual
// columns, since the filter set is expected to keep growing and none of it
// needs to be queried on independently (only ever fetched whole, by owner).
model CandidateSavedSearch {
  id           String     @id @default(cuid())
  name         String
  consultantId String
  consultant   Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  filters      Json
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([consultantId])
}

model CandidateScreeningHistory {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  notes       Json? // JSONB: [{text, createdAt}]
  screenedAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@index([candidateId])
}

// Mirrors StakeholderContactHistory exactly — kept separate from
// CandidateScreeningHistory on purpose: a quick call/email/LinkedIn touch
// isn't the same event as a formal screening pass, and conflating them would
// make "logged a contact" look like "screened this candidate".
model CandidateContactHistory {
  id            String      @id @default(cuid())
  candidateId   String
  candidate     Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  contactType   String // email, call, meeting, linkedin
  contactedById String? // Consultant who made this specific contact — distinct from Candidate.consultantId (the owning consultant); any consultant can log a contact.
  contactedBy   Consultant? @relation(fields: [contactedById], references: [id], onDelete: SetNull)
  notes         String?
  contactedAt   DateTime    @default(now())
  createdAt     DateTime    @default(now())

  @@index([candidateId])
  @@index([contactedById])
}

// ============================================================================
// JOB ORDER (Open positions)
// ============================================================================

model JobOrder {
  id             String                @id @default(cuid())
  displayId      String                @unique @default(dbgenerated("('JO-'::text || lpad((nextval('\"JobOrder_displayId_seq\"'::regclass))::text, 4, '0'::text))")) // Auto: JO-####
  clientId       String
  client         Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  consultantId   String?
  consultant     Consultant?           @relation(fields: [consultantId], references: [id])
  jobTitle       String
  department     String?
  city           String? // Renamed from `location` — matches the Job Orders Portfolio mockup's separate City/Suburb columns. Existing values carried over as-is (free text like "NSW Sydney"); not a real geo split, just the same field renamed.
  suburb         String?
  salaryMin      Float?
  salaryMax      Float?
  salaryCurrency String?               @default("AUD")
  openings       Int                   @default(1)
  filledCount    Int                   @default(0)
  description    String?
  requirements   String?
  status         JobOrderStatus        @default(ACTIVE)
  quality        JobOrderQuality       @default(MEDIUM)
  priorityLevel  Int?                  @default(2) // 1=High, 2=Medium, 3=Low
  isReplacement  Boolean               @default(false) // This job order was opened to replace a placement that fell through within the guarantee period. Flag only — no linking back to the failed placement (per the confirmed "treat as new job" decision).
  isCollaborated Boolean               @default(false) // Two or more consultants worked this job order together (split-desk). Flag only, no multi-owner linking.
  receivedAt     DateTime              @default(now())
  closedAt       DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  deletedAt      DateTime? // Soft delete: null = live
  deletedById    String? // Logical ref to Consultant.id (no FK)
  submissions    CandidateSubmission[]

  @@index([clientId])
  @@index([consultantId])
  @@index([status])
  @@index([quality])
  @@index([deletedAt])
}

// ============================================================================
// CANDIDATE SUBMISSION (Submissions to jobs)
// ============================================================================

model CandidateSubmission {
  id          String           @id @default(cuid())
  candidateId String
  candidate   Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobOrderId  String
  jobOrder    JobOrder         @relation(fields: [jobOrderId], references: [id], onDelete: Cascade)
  status      SubmissionStatus @default(SUBMITTED)
  submittedAt DateTime         @default(now())
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime? // Soft delete: null = live
  deletedById String? // Logical ref to Consultant.id (no FK)
  placement   Placement?
  interviews  Interview[]

  // NOTE: unique is not partial (Fix 2 skipped) — a soft-deleted row still
  // holds (candidateId, jobOrderId). Re-submit must restore the dead row.
  @@unique([candidateId, jobOrderId])
  @@index([candidateId])
  @@index([jobOrderId])
  @@index([status])
  @@index([deletedAt])
}

// ============================================================================
// INTERVIEW (Rounds within a submission's Interviewing stage)
// ============================================================================

// One CandidateSubmission can carry several rounds ("1st Interview", "Final
// Interview", ...) — roundLabel is free text rather than a fixed enum, since
// agencies don't all use the same round-naming convention and this shouldn't
// need a migration to add "2nd Interview" or "Panel Interview" etc.
model Interview {
  id            String            @id @default(cuid())
  submissionId  String
  submission    CandidateSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  roundLabel    String // e.g. "1st Interview", "Final Interview"
  interviewDate DateTime
  outcome       InterviewOutcome  @default(SCHEDULED)
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime? // Soft delete: null = live
  deletedById   String? // Logical ref to Consultant.id (no FK)

  @@index([submissionId])
  @@index([interviewDate])
  @@index([deletedAt])
}

// ============================================================================
// PLACEMENT (Successful placements)
// ============================================================================

// Fee Calculation (see CLAUDE.md's confirmed decisions):
//   Base Salary * (1 + Super%) = Total Package
//   Total Package * Fee% = Placement Fee (feeType PERCENTAGE) — or a flat feeValue (feeType FLAT)
//   guaranteeEndDate = startDate + client.guaranteePeriod (via submission -> jobOrder -> client)
model Placement {
  id               String              @id @default(cuid())
  displayId        String?             @unique // Format: "PLC-XXXX"
  submissionId     String              @unique
  submission       CandidateSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  baseSalary       Float?
  superPercentage  Float               @default(12) // Default per Terms of Business
  totalPackage     Float? // Auto: baseSalary * (1 + superPercentage / 100)
  feeType          PlacementFeeType    @default(PERCENTAGE)
  feePercentage    Float?
  feeValue         Float? // Auto (PERCENTAGE): totalPackage * feePercentage / 100. Entered directly when feeType = FLAT.
  startDate        DateTime?
  guaranteeEndDate DateTime? // Auto-calculated: startDate + client.guaranteePeriod
  accountsNotified Boolean             @default(false)
  status           PlacementStatus     @default(ACTIVE)
  notes            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  deletedAt        DateTime? // Soft delete: null = live
  deletedById      String? // Logical ref to Consultant.id (no FK)

  @@index([displayId])
  @@index([status])
  @@index([startDate])
  @@index([guaranteeEndDate])
  @@index([deletedAt])
}

// ============================================================================
// AUDIT LOG (append-only — every write operation + its actor)
// ============================================================================

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String? // Consultant.id who performed the action; null = system/import
  action     String // CREATE | UPDATE | SOFT_DELETE | RESTORE | HARD_DELETE | DEACTIVATE
  entityType String // "Candidate", "Client", ...
  entityId   String
  changes    Json? // { field: { from, to } } for updates; created row for creates
  metadata   Json? // { requestId?, ip?, cascade?: true }
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}
