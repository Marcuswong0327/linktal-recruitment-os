// Prisma schema — https://pris.ly/d/prisma-schema
// Datasource: PostgreSQL on Neon (auth is handled by NextAuth + Azure AD, not Neon)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pg_trgm]
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

// UNS ("unsuccessful") sits last on purpose — same declaration-order-is-
// sort-order trick as ClientQuality/CandidateStatus — since it's a dead end
// rather than a warmer stage than TRADED.
enum ClientStatus {
  COLD
  WARM
  TRADED
  UNS
}

// Declaration order matters: Postgres native enums sort by declaration
// (ordinal) order, not alphabetically, so this order is what makes
// `ORDER BY quality` come out as LOW < MEDIUM < HIGH.
enum ClientQuality {
  LOW
  MEDIUM
  HIGH
}

// HOT was dropped (never used in the source data) and UNS ("unsuitable")
// added, matching the sheet's actual four values. UNS sits last on purpose —
// same declaration-order-is-sort-order trick as ClientQuality — since it's a
// dead end rather than a warmer stage than PLACED.
enum CandidateStatus {
  COLD
  WARM
  PLACED
  UNS
}

enum JobOrderStatus {
  ACTIVE
  PLACED
  CLOSED
  ON_HOLD
}

// Relationship-warmth status for a Stakeholder, distinct from isAccurate
// (whether their contact details are verified) — a contact can be WARM and
// still have stale details, or COLD with details confirmed fine. DATA_NOT_ACCURATE
// sits last, same declaration-order-is-sort-order trick as ClientStatus/
// CandidateStatus's UNS, since it's a data-quality flag rather than a warmer
// relationship stage.
enum StakeholderStatus {
  COLD
  WARM
  UNS
  DATA_NOT_ACCURATE
}

// What kind of contact this was — screening (a pre-screening call/session
// with the candidate) vs. outreach (a campaign touch). Previously a free
// string ("Detailed Screening Notes" / "Outreach Campaign History") with no
// enforcement; the channel distinction (SMS/email) used to be smuggled into
// this same string ("Outreached Campaign - SMS") rather than living on its
// own field — see OutreachChannel below.
enum ContactCategory {
  SCREENING
  OUTREACH
}

// Which channel an OUTREACH-category contact used. Only two today; more
// will be added as new campaign channels come online.
enum OutreachChannel {
  SMS
  EMAIL
}

// Same declaration-order trick as ClientQuality (see its comment above) —
// LOW < MEDIUM < HIGH lets `ORDER BY quality` come out meaningfully sorted.
enum JobOrderQuality {
  LOW
  MEDIUM
  HIGH
}

enum SubmissionStatus {
  SUBMITTED
  INTERVIEWING
  REJECTED
  PLACED
}

enum PlacementStatus {
  ACTIVE
  COMPLETED
  FAILED
}

enum PlacementFeeType {
  PERCENTAGE
  FLAT
}

enum InterviewOutcome {
  SCHEDULED
  PENDING
  PASSED
  FAILED
  CANCELLED
}

// Four rungs, all sourced from GeoNames (see the Location model) — no rung is
// hand-invented. Linktal's own desk labels ("Brisbane GC QLD", "Klang Valley",
// "East Malaysia") are NOT levels here: they're *groupings* of real nodes,
// expressed as several rows in the relevant join table.
enum LocationLevel {
  COUNTRY
  STATE
  CITY
  SUBURB
}

// ============================================================================
// RBAC TABLES
// ============================================================================

model Role {
  id          String           @id @default(cuid())
  name        String           @unique // admin, manager, consultant, finance, researcher, viewer
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  consultants Consultant[]
}

model Permission {
  id          String           @id @default(cuid())
  resource    String // candidates, clients, jobOrders, etc.
  action      String // create, read, update, delete
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]

  @@unique([resource, action])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

// ============================================================================
// CONSULTANT (Recruiter profile)
// ============================================================================

model Consultant {
  id           String  @id @default(cuid())
  displayId    String  @unique @default(dbgenerated("display_id('CST-'::text, '\"Consultant_displayId_seq\"'::regclass)")) // Auto: CST-000###
  azureId      String? @unique // Azure AD object id (oid claim)
  passwordHash String? // bcrypt hash; set when the consultant has email+password auth enabled
  email        String  @unique
  fullName     String

  // Seniority ("Consultant (Senior)", "Researcher (Intern)", "Support (Finance)")
  // is carried as a JobTitle rather than its own column/enum — it's the same
  // kind of fact as a Stakeholder's title, just for a Linktal employee, so it
  // shares the catalog instead of duplicating one.
  jobTitleId String?
  jobTitle   JobTitle? @relation(fields: [jobTitleId], references: [id], onDelete: SetNull)
  salary     Float? // Monthly cost of this consultant, from the User List sheet.
  costTo     String? // P&L bucket this consultant's cost rolls up to, e.g. "Group P&L"

  reportsToId   String? // Self-relation: this consultant's manager. Nullable — root-level users (e.g. the top manager) have none.
  reportsTo     Consultant?  @relation("ConsultantHierarchy", fields: [reportsToId], references: [id], onDelete: SetNull)
  directReports Consultant[] @relation("ConsultantHierarchy")

  roleId          String?
  role            Role?     @relation(fields: [roleId], references: [id])
  isActive        Boolean   @default(true)
  // True only for a brand-new email+password signup, from the moment
  // RbacService.registerWithPassword creates it (see that method's own
  // isActive=false branch). Cleared to false the first time an admin acts on
  // this row's activation status via ConsultantsController#update — in
  // *either* direction — so it means "awaiting its first admin decision", not
  // "currently inactive". A row an admin approved and later re-deactivated
  // (offboarding) is not pending; a row nobody has touched yet is. Never true
  // for Azure-provisioned or workbook-imported rows — see the two call sites.
  pendingApproval Boolean   @default(false)
  // Stamped only on a real completed sign-in (RbacService.resolveUser /
  // verifyPassword) — never on token refresh. General "last signed in"
  // telemetry; deliberately NOT part of the pendingApproval signal above (an
  // approved-then-reversed row would misreport pending if it were).
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  stakeholderContacts StakeholderContactHistory[]
  candidateContacts   CandidateContactHistory[]
  tobsRepresented     Tob[]
  jobResearch         ClientJobResearch[]
  jobOrderAssignments JobOrderConsultant[] // Which job orders this consultant is working — see SCOPING below and JobOrderConsultant.
  emailTemplates      EmailTemplate[] // See the OUTREACH CAMPAIGNS section below.
  outreachCampaigns   OutreachCampaign[]

  // The two arms of the visibility scope — see the "SCOPING" note below.
  industries      ConsultantIndustry[]
  specializations ConsultantSpecialization[]
  locations       ConsultantLocation[]

  @@index([reportsToId])
  @@index([jobTitleId])
}

// ============================================================================
// SCOPING (how a `consultant`-role user's visible rows are decided)
// ============================================================================
//
//   visible  =  (industry match AND specialization match)  OR  (location match)
//
// Two arms, OR-ed. Each arm is a two-tier hierarchy where a grant covers the
// granted node *plus every descendant*:
//
//   Industry ▸ Specialization ▸ (sub-specialization)      <- ConsultantIndustry / ConsultantSpecialization
//   Country  ▸ State ▸ City ▸ Suburb                      <- ConsultantLocation
//
// Wildcard rule, applied per parent: if a consultant lists specific children
// under a parent they hold, the grant narrows to those children; if they list
// none, the whole parent is granted. So "Australia / [Sydney]" grants CITY
// Sydney, while "Australia / []" grants COUNTRY Australia. Wildcards are
// materialised into concrete grant rows at assignment/import time rather than
// stored as an "unrestricted" flag, so every grant stays auditable — and so
// that zero rows unambiguously means "not configured", never "sees everything".
//
// Null handling differs by tier on purpose: Client/Candidate.industryId is
// REQUIRED, so the industry tier never has to decide what an untagged row
// means. Specialization is nullable, and an unspecialised row matches any
// grant on its industry (otherwise the ~72% of candidates with no
// specialization would vanish the moment that arm is switched on).
//
// Specialization filtering ships stored-but-inactive: the consultant-side
// vocabulary is coarse ("Food") while the record-side is fine ("Food Meat"),
// and the parent tier added to Specialization is what reconciles them. It's
// enabled once the catalog backfill lands.
//
// This is a pure LIST FILTER, never a gate on direct access — there is no
// per-record consultantId ownership on Client/Candidate anymore. The one
// deliberate way to reach an out-of-scope Client/Candidate is to be added to
// a JobOrder (JobOrderConsultant, below): that surfaces the job order's own
// Client and the Candidates submitted to THAT job order specifically, out of
// scope or not — no guard blocks it, by design.

// Many-to-many: which industries a consultant is scoped to (they can carry
// several, unlike Client/Candidate's single industryId). Explicit join model
// rather than an implicit Prisma m2m so it can be written as individual
// top-level create/delete calls (audited by the generic Prisma extension)
// instead of a nested relation write (which the extension can't diff).
model ConsultantIndustry {
  consultantId String
  consultant   Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  industryId   String
  industry     Industry   @relation(fields: [industryId], references: [id], onDelete: Cascade)

  @@id([consultantId, industryId])
  @@index([industryId])
}

// Narrows the industry arm: a consultant holding Manufacturing plus
// specializations [Food, Packaging] sees only those branches of Manufacturing,
// while one holding Manufacturing with no specialization rows sees all of it.
// Grants are usually made at a parent Specialization ("Food"), which covers
// every child ("Food Meat", "Food Bakery", ...).
model ConsultantSpecialization {
  consultantId     String
  consultant       Consultant     @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  specializationId String
  specialization   Specialization @relation(fields: [specializationId], references: [id], onDelete: Cascade)

  @@id([consultantId, specializationId])
  @@index([specializationId])
}

// Many-to-many: which Location nodes a consultant is scoped to — at ANY level
// (country, state, city, or suburb), same pattern as StakeholderLocation and
// ClientLocation. This is where a Linktal desk label is expanded into real
// nodes: "Brisbane GC QLD" becomes two CITY rows (Brisbane, Gold Coast),
// "East Malaysia" becomes two STATE rows (Sabah, Sarawak).
model ConsultantLocation {
  consultantId String
  consultant   Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  locationId   String
  location     Location   @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([consultantId, locationId])
  @@index([locationId])
}

// ============================================================================
// SHARED REFERENCE TABLES (Location, JobTitle, role types)
// ============================================================================

// A single hierarchical geography tree, bulk-loaded from GeoNames — countries,
// admin1 (states/regions), cities5000, and postal places for suburbs. Nothing
// in this table is hand-typed: `location:create` is admin-only (unlike
// Industry/JobTitle, which are combobox-growable), because the scope resolver
// reads this tree and a drifted node silently changes who can see what.
//
// Australia -> New South Wales -> Sydney -> Silverwater 2128 is a 4-node chain
// (parentId self-relation); `level` says which rung a row sits on and
// `postcode` is only ever set at SUBURB level.
//
// Candidate/JobOrder/ClientJobResearch each point at their single most-specific
// known node — a candidate known only to city level points at the CITY row, one
// with a suburb points at the SUBURB row, whose parent chain still resolves back
// up to city, state and country. Client, Stakeholder and Consultant instead
// carry *sets* of nodes at mixed granularity (ClientLocation /
// StakeholderLocation / ConsultantLocation), so "covers all of Malaysia" is one
// COUNTRY row rather than every city underneath it. Matching one side against
// the other is then just walking the specific node up its parent chain and
// checking for a hit, whichever level either side happened to specify.
model Location {
  id          String        @id @default(cuid())
  name        String // "Australia" / "New South Wales" / "Sydney" / "Silverwater"
  level       LocationLevel
  postcode    String? // only meaningful at SUBURB level
  geonameId   Int?          @unique // GeoNames id — makes the bulk load idempotent and re-runnable
  parentId    String?
  // Self plus every ancestor, root-last: Silverwater -> [silverwater, sydney,
  // nsw, australia]. Denormalized so "is this record inside a granted node"
  // is one indexed `hasSome` against the consultant's grant list, rather than
  // a recursive CTE per query or a 1,500-element IN clause from expanding a
  // COUNTRY grant downward. Maintained by the loader (this tree is
  // bulk-written and admin-only, so it changes rarely).
  ancestorIds String[]
  parent      Location?     @relation("LocationTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Location[]    @relation("LocationTree")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  candidates        Candidate[]
  jobOrders         JobOrder[]
  clientJobResearch ClientJobResearch[]
  clients           ClientLocation[]
  stakeholders      StakeholderLocation[]
  consultants       ConsultantLocation[]

  @@unique([parentId, name])
  @@index([level])
  @@index([parentId])
  @@index([ancestorIds], type: Gin)
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Location_name_trgm_idx")
}

// The job title as the *company* words it — "Product Engineer", "R&D Lab
// Technician and compounder", "Chairman". Deliberately distinct from the role
// types below, which are how a Linktal consultant classifies that same job
// ("Software Engineer"). Combobox-growable by anyone: it carries no scoping
// weight, so free creation costs nothing but speeds up data entry.
model JobTitle {
  id           String              @id @default(cuid())
  name         String              @unique
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  stakeholders Stakeholder[]
  jobResearch  ClientJobResearch[]
  jobOrders    JobOrder[]
  consultants  Consultant[]
}

// The consultant's own classification of a *job* — "Electrician", "Fitter
// Lead", "Production Planner", "CNC Machinist". Kept separate from
// StakeholderRoleType because the two vocabularies never overlap: you'd never
// tag a CFO as an Electrician, and mixing them would put trades in the
// dropdown when classifying a finance contact. Combobox-growable (no scoping
// weight); used for filtering candidates against job orders.
model JobRoleType {
  id          String              @id @default(cuid())
  name        String              @unique
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  candidates  Candidate[]
  jobOrders   JobOrder[]
  jobResearch ClientJobResearch[]
}

// The consultant's classification of a *contact* — the function they sit in
// at the client: HR, Finance, Safety, Procurement, Estimating, GM CEO. See
// JobRoleType above for why these are two tables and not one.
model StakeholderRoleType {
  id           String        @id @default(cuid())
  name         String        @unique
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  stakeholders Stakeholder[]
}

// ============================================================================
// INDUSTRY / SPECIALIZATION (the first arm of the visibility scope)
// ============================================================================

// Reference table for Client/Candidate.industry and the consultant industry
// grant. `industry:create` is admin+manager only — unlike JobTitle/role types,
// this is scope-bearing, and a consultant inventing a near-duplicate industry
// would silently move records outside their own desk.
model Industry {
  id              String               @id @default(cuid())
  name            String               @unique
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  clients         Client[]
  candidates      Candidate[] // Shared taxonomy: same catalog Client.industry uses.
  consultants     ConsultantIndustry[]
  specializations Specialization[]
}

// A specialization belongs to exactly one Industry, and may itself sit under a
// parent Specialization — the source data already encodes that second tier in
// its naming ("Engineering Parts Fibre Optics" under "Engineering Parts",
// "Food Meat" under "Food"), it just wasn't structured as a hierarchy. The
// parent tier is what makes the scope arm work: consultants grant coarse
// categories ("Food"), while clients and candidates tag specific leaves ("Food
// Bakery"), and a grant covers the node plus all descendants — identical
// resolution to the Location tree, so both arms share one helper.
//
// `name` is unique per-industry rather than globally: the same specialization
// name could plausibly exist under two different industries. Admin+manager
// create only, same scope-bearing reasoning as Industry.
model Specialization {
  id          String           @id @default(cuid())
  name        String
  industryId  String
  industry    Industry         @relation(fields: [industryId], references: [id], onDelete: Restrict)
  parentId    String? // null = a top-level category directly under its Industry
  parent      Specialization?  @relation("SpecializationTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Specialization[] @relation("SpecializationTree")
  // Self plus every ancestor — same purpose and shape as Location.ancestorIds,
  // so both arms of the scope resolver share one code path.
  ancestorIds String[]
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  clients     Client[]
  candidates  CandidateSpecialization[]
  consultants ConsultantSpecialization[]

  @@unique([industryId, name])
  @@index([industryId])
  @@index([parentId])
  @@index([ancestorIds], type: Gin)
}

// ============================================================================
// CLIENT (Companies hiring)
// ============================================================================

model Client {
  id          String @id @default(cuid())
  displayId   String @unique @default(dbgenerated("display_id('CLI-'::text, '\"Client_displayId_seq\"'::regclass)")) // Auto: CLI-000###
  companyName String

  // Required — the industry arm of the scope resolver relies on this never
  // being null (see the SCOPING note above). Specialization is the optional
  // narrowing within it.
  industryId       String
  industry         Industry        @relation(fields: [industryId], references: [id], onDelete: Restrict)
  specializationId String?
  specialization   Specialization? @relation(fields: [specializationId], references: [id], onDelete: SetNull)

  // Where this client SEEKS candidates from (its hiring market), not its own
  // office address — a *set* of nodes at any level, since the source data is
  // routinely multi-valued ("Sydney NSW; Melbourne VIC; Brisbane GC QLD").
  // At least one node (country level at minimum) is required, enforced in the
  // service layer rather than by the schema, which can't express "non-empty
  // relation".
  locations ClientLocation[]

  addresses            Json? // "Address(es)" — the client's own physical office address(es), distinct from `locations` above. Array of strings.
  suburbsAndPostcodes  Json? // "Suburb & Postcode (es)" — the client's own office suburb/postcode(s), same distinction as addresses. Array of strings.
  website              String?
  seekJobMarketUrl     String? // "Seek/Job Street Job Market URL"
  linkedinJobMarketUrl String? // "Linkedin Job Market URL"
  generalDescription   String? // "General Description"

  status            ClientStatus  @default(COLD)
  quality           ClientQuality @default(MEDIUM)
  lastContactedAt   DateTime? // Denormalized: max(StakeholderContactHistory.contactedAt) across this client's stakeholders. Lets the list sort by it without a cross-table aggregate on every page load; source of truth stays StakeholderContactHistory.
  lastContactedById String? // Logical ref to Consultant.id (no FK) — denormalized, mirrors lastContactedAt.
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime? // Soft delete: null = live
  deletedById       String? // Logical ref to Consultant.id (no FK)

  stakeholders Stakeholder[]
  jobResearch  ClientJobResearch[]
  jobOrders    JobOrder[]
  tobs         Tob[] // Terms of Business — one-to-many: a client can have multiple TOB records over time

  @@index([status])
  @@index([deletedAt])
  @@index([industryId])
  @@index([specializationId])
  @@index([lastContactedAt])
  @@index([quality])
}

// Many-to-many: a client's hiring market, at mixed granularity — see the
// Location model's comment for how matching works.
model ClientLocation {
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([clientId, locationId])
  @@index([locationId])
}

// ============================================================================
// TOB (Terms of Business — one-to-many per client)
// ============================================================================

// A client can carry several TOB records over time (a signed document, a
// supplier agreement, an email-confirmed arrangement, ...) — pricing,
// guarantee period and payment term live per-record here rather than as flat
// fields on Client, since two TOBs for the same client can disagree on terms.
//
// Everything but `clientId` is optional: only ~6-24% of the historical records
// carry commercial detail at all.
model Tob {
  id        String @id @default(cuid())
  displayId String @unique @default(dbgenerated("display_id('TOB-'::text, '\"Tob_displayId_seq\"'::regclass)")) // Auto: TOB-000###
  clientId  String
  client    Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  fileName                String?
  fileType                String? // e.g. "TOB Document", "Email Communication"
  sourceFileLink          String? // e.g. SharePoint URL
  clientTobRepresentative String? // Contact name (+ details) on the client side who signed/agreed
  linktalRepresentativeId String?
  linktalRepresentative   Consultant? @relation(fields: [linktalRepresentativeId], references: [id], onDelete: SetNull)

  // Free text, not a number: real values include "13%-(80k below)15%-18%"
  // alongside plain percentages, and the source workbook's own convention note
  // says pricing schedules are text.
  pricing         String?
  guaranteePeriod Int? // Days. Numeric so it stays computable, even though the sheet writes "6 Months".
  paymentTerm     String? // e.g. "30 days from invoice"

  invoiceContactName  String?
  invoiceContactEmail String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime? // Soft delete: null = live
  deletedById         String? // Logical ref to Consultant.id (no FK)

  @@index([clientId])
  @@index([linktalRepresentativeId])
  @@index([deletedAt])
}

// ============================================================================
// STAKEHOLDER (Contacts at client companies)
// ============================================================================

model Stakeholder {
  id        String @id @default(cuid())
  displayId String @unique @default(dbgenerated("display_id('STK-'::text, '\"Stakeholder_displayId_seq\"'::regclass)")) // Auto: STK-000###
  clientId  String
  client    Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Which Location nodes this stakeholder covers — matched against a
  // candidate's/client's own location on the stakeholder's OWN coverage,
  // independent of where the parent client sits (a Brisbane client's national
  // account manager can cover Sydney).
  coverage StakeholderLocation[]

  firstName String?
  lastName  String?

  // The company's words for the role vs. the consultant's classification of it
  // — both kept, deliberately (see JobTitle / StakeholderRoleType).
  jobTitleId            String?
  jobTitle              JobTitle?            @relation(fields: [jobTitleId], references: [id], onDelete: SetNull)
  stakeholderRoleTypeId String?
  stakeholderRoleType   StakeholderRoleType? @relation(fields: [stakeholderRoleTypeId], references: [id], onDelete: SetNull)

  linkedinUrl String?
  email       String?
  mobile      String?

  generalDescription String? // Free-text notes about this stakeholder — same purpose as Client.generalDescription.

  lastContactedAt   DateTime? // Denormalized: max(StakeholderContactHistory.contactedAt) for this stakeholder. Prisma's relation-aggregate `orderBy` only supports `_count` (not `_max`) on to-many relations, so sorting needs a real column, not a live join.
  lastContactedById String? // Logical ref to Consultant.id (no FK) — denormalized, mirrors lastContactedAt.
  status            StakeholderStatus @default(COLD) // Relationship-warmth status, distinct from isAccurate below.
  isAccurate        Boolean? // Whether this stakeholder's details have been verified — nullable rather than defaulted, since "not yet checked" isn't "confirmed accurate".
  inaccurateReason  String? // Free text explaining what's wrong, when isAccurate is false.
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime? // Soft delete: null = live
  deletedById       String? // Logical ref to Consultant.id (no FK)

  contactHistory             StakeholderContactHistory[]
  outreachCampaignRecipients OutreachCampaignRecipient[] // See the OUTREACH CAMPAIGNS section below.

  @@index([clientId])
  @@index([deletedAt])
  @@index([jobTitleId])
  @@index([stakeholderRoleTypeId])
  @@index([lastContactedAt])
}

// Many-to-many: a stakeholder can cover several Location nodes at mixed
// granularity (one row for "Malaysia" as a whole, another for a specific city
// elsewhere) — see the Location model's comment for how matching works.
model StakeholderLocation {
  stakeholderId String
  stakeholder   Stakeholder @relation(fields: [stakeholderId], references: [id], onDelete: Cascade)
  locationId    String
  location      Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([stakeholderId, locationId])
  @@index([locationId])
}

model StakeholderContactHistory {
  id            String      @id @default(cuid())
  displayId     String      @unique @default(dbgenerated("display_id('CN-'::text, '\"StakeholderContactHistory_displayId_seq\"'::regclass)")) // Auto: CN-000###
  stakeholderId String
  stakeholder   Stakeholder @relation(fields: [stakeholderId], references: [id], onDelete: Cascade)

  contactType   String? // Channel: email, call, meeting, linkedin
  category      String? // "Detailed Brief Notes" or "Outreach Campaign History" — the sheet's own type column, distinct from contactType (channel)
  contactedById String? // Consultant who made this specific contact — distinct from Client.consultantId (the account owner); any consultant can log a contact.
  contactedBy   Consultant? @relation(fields: [contactedById], references: [id], onDelete: SetNull)
  notes         String?
  contactedAt   DateTime    @default(now())
  createdAt     DateTime    @default(now())

  @@index([stakeholderId])
  @@index([contactedById])
}

// ============================================================================
// CLIENT JOB RESEARCH (Job openings found in the market)
// ============================================================================

// Public job-ad research (Seek/LinkedIn), deliberately separate from JobOrder:
// this is what's advertised in the market, not a brief Linktal has been given.
model ClientJobResearch {
  id        String @id @default(cuid())
  displayId String @unique @default(dbgenerated("display_id('JR-'::text, '\"ClientJobResearch_displayId_seq\"'::regclass)")) // Auto: JR-000###
  clientId  String
  client    Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  consultantId String? // Who conducted this research — usually a researcher-role consultant, but not schema-restricted to that role (an RBAC concern, not a data-model one).
  consultant   Consultant? @relation(fields: [consultantId], references: [id], onDelete: SetNull)

  locationId String? // The most specific known Location node — replaces the sheet's separate "City Advertised"/"Suburbs" columns.
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  jobTitleId    String? // "Job Title in market" — the advertiser's own words.
  jobTitle      JobTitle?    @relation(fields: [jobTitleId], references: [id], onDelete: SetNull)
  jobRoleTypeId String? // The consultant's classification of that ad.
  jobRoleType   JobRoleType? @relation(fields: [jobRoleTypeId], references: [id], onDelete: SetNull)

  status             ClientStatus? // Snapshot of the client's status when this research was logged, not a live reference.
  seekUrl            String?
  permanentUrl       String?
  postedDate         DateTime? // When the ad was posted (distinct from researchedAt, when the consultant logged it).
  contactEmailFromAd String?
  salaryRange        String? // Free text copied off the ad (e.g. "salary + super + FMCV + bonus scheme").
  isContacted        Boolean       @default(false)
  researchedAt       DateTime      @default(now())
  lastContactedAt    DateTime?
  lastContactedById  String? // Logical ref to Consultant.id (no FK).
  notes              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deletedAt          DateTime? // Soft delete: null = live
  deletedById        String? // Logical ref to Consultant.id (no FK)

  jobOrder JobOrder?

  @@index([clientId])
  @@index([consultantId])
  @@index([jobTitleId])
  @@index([jobRoleTypeId])
  @@index([locationId])
  @@index([deletedAt])
}

// ============================================================================
// CANDIDATE (Job seekers)
// ============================================================================

model Candidate {
  id        String  @id @default(cuid())
  displayId String  @unique @default(dbgenerated("display_id('CDD-'::text, '\"Candidate_displayId_seq\"'::regclass)")) // Auto: CDD-000###
  firstName String?
  lastName  String?
  email     String?
  mobile    String?

  // Required, both of them — the two coarse tiers the scope resolver can't
  // work without (see the SCOPING note). Everything finer is optional.
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  industryId String
  industry   Industry @relation(fields: [industryId], references: [id], onDelete: Restrict)

  // Free-text "Suburb & Postcode" (e.g. "Merrylands 2160 NSW") — deliberately
  // separate from locationId above, not a replacement for it. Suburb-level
  // Location rows (and postcodes) were never loaded from GeoNames — City is
  // the finest grant the scope resolver actually has (see
  // docs/scope-explained.md) — so this can't be a structured pick like
  // locationId is. Purely descriptive; plays no part in scoping.
  suburbAndPostcode String?

  specializations CandidateSpecialization[]

  // The consultant's classification of what this person does. There's no
  // company-assigned JobTitle here — a candidate's equivalent is `currentRole`,
  // their actual title at their current employer.
  jobRoleTypeId String?
  jobRoleType   JobRoleType? @relation(fields: [jobRoleTypeId], references: [id], onDelete: SetNull)

  currentRole     String? // "Lastest Role" — free text on purpose, it's the employer's title.
  currentCompany  String?
  // Direct edit from the candidate detail page — for correcting a typo in
  // what's already shown, not for logging a new salary event (that's still
  // CandidateContactHistory.currentSalary/expectedSalary via "Log Contact").
  // When set, the API prefers this over the latest logged contact's value;
  // when null (the default for every candidate that's never been directly
  // edited), the latest logged contact's value shows through unchanged. Free
  // text, same reasoning as CandidateContactHistory.currentSalary.
  currentSalary   String?
  expectedSalary  String?
  linkedinUrl     String?
  seekTalentUrl   String?
  rawResumeUrl    String? // "Raw Resume File" — the original, as-submitted resume.
  editedResumeUrl String? // "Linktal Edited File" — Linktal's own reformatted version.
  workHistory     Json? // JSONB: [{company, role, period}] — consolidated timeline replacing the sheet's separate "Previous Company 1/2", "Previous Role 1/2" columns. `period` is free text ("2020 - 2021 (1 year)"); the source never stores parseable dates.
  historicFiles   Json? // JSONB: [{key, fileName}] — older/superseded resume or document versions, uploaded the same way as rawResumeUrl/editedResumeUrl.
  otherDocuments  Json? // JSONB: [{key, fileName}] — any other supporting document (references, certs, etc.) attached to the candidate.

  status CandidateStatus @default(COLD)

  lastContactedAt   DateTime? // Denormalized: max(CandidateContactHistory.contactedAt).
  lastContactedById String? // Logical ref to Consultant.id (no FK) — denormalized, mirrors lastContactedAt.
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime? // Soft delete: null = live
  deletedById       String? // Logical ref to Consultant.id (no FK)

  contactHistory CandidateContactHistory[]
  submissions    CandidateSubmission[]

  @@index([status])
  @@index([email])
  @@index([deletedAt])
  @@index([lastContactedAt])
  @@index([industryId])
  @@index([jobRoleTypeId])
  @@index([locationId])
  // Trigram indexes back the quick-search's ILIKE/`contains` filters — turns a
  // substring scan on these columns into an index scan instead of a sequential
  // one, which is what keeps search fast as the candidate pool grows.
  @@index([firstName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Candidate_firstName_trgm_idx")
  @@index([lastName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Candidate_lastName_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "Candidate_email_trgm_idx")
  @@index([currentRole(ops: raw("gin_trgm_ops"))], type: Gin, map: "Candidate_currentRole_trgm_idx")
  @@index([currentCompany(ops: raw("gin_trgm_ops"))], type: Gin, map: "Candidate_currentCompany_trgm_idx")
  @@index([mobile(ops: raw("gin_trgm_ops"))], type: Gin, map: "Candidate_mobile_trgm_idx")
  @@index([displayId(ops: raw("gin_trgm_ops"))], type: Gin, map: "Candidate_displayId_trgm_idx")
}

// Many-to-many: a candidate can carry several specializations, unlike Client's
// single specializationId. Explicit join model, same audit-diffing reasoning as
// ConsultantIndustry.
model CandidateSpecialization {
  candidateId      String
  candidate        Candidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  specializationId String
  specialization   Specialization @relation(fields: [specializationId], references: [id], onDelete: Cascade)

  @@id([candidateId, specializationId])
  @@index([specializationId])
}

// Screening notes and outreach notes both live here, distinguished by
// `category` ("Detailed Screening Notes" vs "Outreach Campaign History") — the
// source sheet never had a separate screening table, which is why the old
// CandidateScreeningHistory model was dropped as redundant.
model CandidateContactHistory {
  id          String    @id @default(cuid())
  displayId   String    @unique @default(dbgenerated("display_id('CDN-'::text, '\"CandidateContactHistory_displayId_seq\"'::regclass)")) // Auto: CDN-000###
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  contactType   String? // Channel: email, call, meeting, linkedin
  category      ContactCategory // SCREENING or OUTREACH.
  contactedById String? // Consultant who made this specific contact.
  contactedBy   Consultant?     @relation(fields: [contactedById], references: [id], onDelete: SetNull)
  contactedAt   DateTime        @default(now())

  outreachChannel       OutreachChannel? // Which channel an OUTREACH contact used — only set when category is OUTREACH.
  outreachCampaignNotes String? // Free-text campaign context — filled when category is OUTREACH. Independent of outreachChannel: this is "which campaign/job", not "which channel".
  screeningNotes        String? // The actual screening call content — filled when category is SCREENING. Renamed from conversationSummary. Editable (author-or-admin, optimistic concurrency — see editedAt/editedById); every other field on this row is an immutable factual record once logged.
  status                CandidateStatus  @default(WARM) // Snapshot of the candidate's status at the time of this contact, not a live reference.
  suburb                String?

  editedAt   DateTime? // Set only when screeningNotes has been edited after creation.
  editedById String? // Logical ref to Consultant.id (no FK) — who made the last edit; may differ from contactedById (e.g. an admin correcting someone else's note).

  // Free text, not numbers: the source records these as "35 per hour", "more
  // 53-55", "above 47". Storing them numerically would drop ~740 populated
  // values on import. Same reasoning as Tob.pricing.
  currentSalary  String?
  expectedSalary String?
  createdAt      DateTime @default(now())

  @@index([candidateId])
  @@index([contactedById])
}

// ============================================================================
// JOB ORDER (Open positions Linktal has been briefed on)
// ============================================================================

model JobOrder {
  id        String @id @default(cuid())
  displayId String @unique @default(dbgenerated("display_id('JO-'::text, '\"JobOrder_displayId_seq\"'::regclass)")) // Auto: JO-000###
  clientId  String
  client    Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Who's working this job order — deliberately many-to-many (see
  // JobOrderConsultant below): several consultants can work the same job
  // order concurrently, and being on this list is also the one way to reach
  // an otherwise out-of-scope Client/Candidate (see the SCOPING note above
  // Consultant).
  consultants JobOrderConsultant[]

  // Both, same split as Stakeholder: the client's brief vs. the consultant's
  // classification. The sheet has a single "Role" column, imported into both.
  jobTitleId    String?
  jobTitle      JobTitle?    @relation(fields: [jobTitleId], references: [id], onDelete: SetNull)
  jobRoleTypeId String?
  jobRoleType   JobRoleType? @relation(fields: [jobRoleTypeId], references: [id], onDelete: SetNull)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  jobResearchId String?            @unique // Optional link back to the ClientJobResearch row this job order originated from, if any.
  jobResearch   ClientJobResearch? @relation(fields: [jobResearchId], references: [id], onDelete: SetNull)

  salaryMin      Float?
  salaryMax      Float?
  salaryCurrency String? @default("AUD")
  estimatedValue Float? // "Value" on the sheet — a forecast entered before anyone's placed. Distinct from Placement.feeValue, the actual fee after a successful placement.

  openings     Int     @default(1)
  filledCount  Int     @default(0)
  description  String?
  requirements String?
  notes        String? // "Briefing Notes" — internal recruiter notes, distinct from description/requirements (public-facing job-ad copy).

  // Document links for this job order — same "just a URL, not always a real
  // URL" reasoning as Tob.sourceFileLink (SharePoint links, bare paths, etc.).
  jdFileUrl         String? // The job description document.
  clientAdsUrl      String? // The client's own published ad for this role.
  otherDocumentsUrl String? // Anything else supporting this job order.

  // Denormalized, kept in sync by SubmissionsService.recomputeJobOrderCounters
  // on every submission create/update/remove. Exist purely so the Job Orders
  // list can sort by them: Prisma's orderBy relation aggregates (_count/_max)
  // take no `where`, so they can't express "exclude REJECTED" or "exclude
  // soft-deleted rows" — see JobOrdersService.findAll's sortBy handling.
  activeSubmissionCount Int       @default(0) // submissions.count(status != REJECTED, not soft-deleted)
  lastSubmittedAt       DateTime? // max(submittedAt) across not-soft-deleted submissions

  status        JobOrderStatus  @default(ACTIVE)
  quality       JobOrderQuality @default(MEDIUM)
  priorityLevel Int?            @default(2) // 1=High, 2=Medium, 3=Low
  receivedAt    DateTime        @default(now())
  closedAt      DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime? // Soft delete: null = live
  deletedById   String? // Logical ref to Consultant.id (no FK)

  submissions CandidateSubmission[]

  @@index([clientId])
  @@index([status])
  @@index([quality])
  @@index([deletedAt])
  @@index([locationId])
  @@index([jobTitleId])
  @@index([jobRoleTypeId])
}

// Many-to-many: which consultants are working a given job order. Explicit
// join model, same audit-diffing reasoning as ConsultantIndustry — written as
// individual top-level create/delete calls (never a nested relation write) so
// the generic Prisma audit extension actually sees and diffs each row. No
// scope-mismatch guard applies to this table: assigning someone here on
// purpose reaches outside their normal industry/location grants — that's the
// entire point (see the SCOPING note above Consultant).
model JobOrderConsultant {
  jobOrderId String
  jobOrder   JobOrder @relation(fields: [jobOrderId], references: [id], onDelete: Cascade)

  consultantId String
  consultant   Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([jobOrderId, consultantId])
  @@index([consultantId])
}

// ============================================================================
// CANDIDATE SUBMISSION (Submissions to jobs)
// ============================================================================

model CandidateSubmission {
  id          String           @id @default(cuid())
  displayId   String           @unique @default(dbgenerated("display_id('SUB-'::text, '\"CandidateSubmission_displayId_seq\"'::regclass)")) // Auto: SUB-000###
  candidateId String
  candidate   Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobOrderId  String
  jobOrder    JobOrder         @relation(fields: [jobOrderId], references: [id], onDelete: Cascade)
  status      SubmissionStatus @default(SUBMITTED)
  submittedAt DateTime         @default(now())

  // The Job Order pipeline table's three tick/cross stages, each a tri-state
  // boolean of its own (null = undecided, not derived from `status` or from
  // each other) — the UI gates each stage on the previous one being ticked,
  // but that's a frontend concern, not a stored relationship between these
  // columns. Interview outcome (PASSED/FAILED) is the middle stage; it
  // already lives on Interview.outcome, not duplicated here.
  shortlisted Boolean? // Client shortlisted this candidate to interview.
  cddAccepted Boolean? // Candidate accepted the offer (set alongside creating the Placement — see PlacementsService).

  notes String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime? // Soft delete: null = live
  deletedById String? // Logical ref to Consultant.id (no FK)
  placement   Placement?
  interviews  Interview[]

  // NOTE: unique is not partial — a soft-deleted row still holds
  // (candidateId, jobOrderId). Re-submit must restore the dead row.
  @@unique([candidateId, jobOrderId])
  @@index([candidateId])
  @@index([jobOrderId])
  @@index([status])
  @@index([deletedAt])
}

// ============================================================================
// INTERVIEW (Rounds within a submission's Interviewing stage)
// ============================================================================

// One CandidateSubmission can carry several rounds ("1st Interview", "Final
// Interview", ...) — roundLabel is free text rather than a fixed enum, since
// agencies don't all use the same round-naming convention and this shouldn't
// need a migration to add "Panel Interview".
model Interview {
  id            String              @id @default(cuid())
  displayId     String              @unique @default(dbgenerated("display_id('INT-'::text, '\"Interview_displayId_seq\"'::regclass)")) // Auto: INT-000###
  submissionId  String
  submission    CandidateSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  roundLabel    String
  interviewDate DateTime
  outcome       InterviewOutcome    @default(SCHEDULED)
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  deletedAt     DateTime? // Soft delete: null = live
  deletedById   String? // Logical ref to Consultant.id (no FK)

  @@index([submissionId])
  @@index([interviewDate])
  @@index([deletedAt])
}

// ============================================================================
// PLACEMENT (Successful placements)
// ============================================================================

// Fee Calculation:
//   Base Salary * (1 + Super%) = Total Package
//   Total Package * Fee% = Placement Fee (feeType PERCENTAGE) — or a flat feeValue (feeType FLAT)
//
// guaranteeEndDate is entered MANUALLY, not derived. It used to be computed
// from Client.guaranteePeriod, but guarantee terms now live per-Tob and a
// client can hold several disagreeing ones — picking the applicable TOB
// automatically would be guesswork, so the consultant sets the date.
model Placement {
  id               String              @id @default(cuid())
  displayId        String              @unique @default(dbgenerated("display_id('PLC-'::text, '\"Placement_displayId_seq\"'::regclass)")) // Auto: PLC-000###
  submissionId     String              @unique
  submission       CandidateSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  baseSalary       Float?
  superPercentage  Float               @default(12) // Default per Terms of Business
  totalPackage     Float? // Auto: baseSalary * (1 + superPercentage / 100)
  feeType          PlacementFeeType    @default(PERCENTAGE)
  feePercentage    Float?
  feeValue         Float? // Auto (PERCENTAGE): totalPackage * feePercentage / 100. Entered directly when feeType = FLAT.
  startDate        DateTime?
  guaranteeEndDate DateTime? // Manual — see the model comment above.
  accountsNotified Boolean             @default(false)
  status           PlacementStatus     @default(ACTIVE)
  notes            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  deletedAt        DateTime? // Soft delete: null = live
  deletedById      String? // Logical ref to Consultant.id (no FK)

  @@index([displayId])
  @@index([status])
  @@index([startDate])
  @@index([guaranteeEndDate])
  @@index([deletedAt])
}

// ============================================================================
// AUDIT LOG (append-only — every write operation + its actor)
// ============================================================================

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String? // Consultant.id who performed the action; null = system/import
  action     String // CREATE | UPDATE | SOFT_DELETE | RESTORE | HARD_DELETE | DEACTIVATE
  entityType String // "Candidate", "Client", ...
  entityId   String
  changes    Json? // { field: { from, to } } for updates; created row for creates
  metadata   Json? // { requestId?, ip?, cascade?: true }
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// ============================================================================
// OUTREACH CAMPAIGNS (mail-merge campaigns to Stakeholders, via Smartlead)
// ============================================================================
//
// These three tables + this enum were built and applied directly to the
// shared dev database (via `db push` or raw SQL, not a committed migration),
// so they existed live with real data before ever landing in this repo. This
// block backfills the schema + a migration to close that drift — see
// `20260821000000_backfill_outreach_campaigns` for the migration itself.
//
// No NestJS module/controller/service for this feature exists anywhere in
// this repo yet — only the schema. Whoever owns this feature still needs to
// bring the actual application code over.

enum OutreachCampaignStatus {
  DRAFT
  QUEUED
  SENDING
  COMPLETED
  FAILED
}

model EmailTemplate {
  id          String      @id @default(cuid())
  displayId   String      @unique @default(dbgenerated("display_id('EMT-'::text, '\"EmailTemplate_displayId_seq\"'::regclass)")) // Auto: EMT-000###
  name        String
  subject     String
  bodyHtml    String
  createdById String? // Logical: Consultant who created this template.
  createdBy   Consultant? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([createdById])
  @@index([updatedAt])
}

model OutreachCampaign {
  id                  String                      @id @default(cuid())
  displayId           String                      @unique @default(dbgenerated("display_id('OCH-'::text, '\"OutreachCampaign_displayId_seq\"'::regclass)")) // Auto: OCH-000###
  name                String
  subject             String
  bodyHtml            String
  timezoneRegion      String                      @default("MY")
  sendDaysPerWeek     Int                         @default(5)
  senderAccountIds    Json                        @default("[]") // JSONB array of sending-account ids — not a relation, no EmailConnection/sender-account model exists in this repo.
  status              OutreachCampaignStatus      @default(DRAFT)
  smartleadCampaignId String? // Third-party (Smartlead) campaign id once launched.
  createdById         String
  createdBy           Consultant                  @relation(fields: [createdById], references: [id], onDelete: Restrict)
  launchedAt          DateTime?
  totalRecipients     Int                         @default(0)
  sentCount           Int                         @default(0)
  errorMessage        String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  recipients          OutreachCampaignRecipient[]

  @@index([createdAt])
  @@index([createdById])
  @@index([status])
}

model OutreachCampaignRecipient {
  id              String           @id @default(cuid())
  campaignId      String
  campaign        OutreachCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  stakeholderId   String?
  stakeholder     Stakeholder?     @relation(fields: [stakeholderId], references: [id], onDelete: SetNull)
  firstName       String?
  email           String
  emailNormalized String
  createdAt       DateTime         @default(now())

  @@unique([campaignId, emailNormalized])
  @@index([stakeholderId])
}
