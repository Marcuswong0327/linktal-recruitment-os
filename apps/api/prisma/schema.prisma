// Prisma schema — https://pris.ly/d/prisma-schema
// Datasource: PostgreSQL on Neon.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum CandidateStatus {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

model Candidate {
  id        String          @id @default(cuid())
  name      String
  email     String          @unique
  role      String
  status    CandidateStatus @default(APPLIED)
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([status])
}
