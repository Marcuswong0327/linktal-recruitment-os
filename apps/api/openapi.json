    "/candidates": {
      "get": {
        "operationId": "getCandidates",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "Page number (1-based)",
            "schema": {
              "minimum": 1,
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "pageSize",
            "required": false,
            "in": "query",
            "description": "Items per page",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "type": "number"
            }
          },
          {
            "name": "sortBy",
            "required": false,
            "in": "query",
            "description": "Column to sort by. Defaults to most recently created.",
            "schema": {
              "type": "string",
              "enum": [
                "displayId",
                "fullName",
                "familyName",
                "givenName",
                "email",
                "city",
                "country",
                "industry",
                "roleType",
                "currentCompany",
                "currentPosition",
                "yearsExperience",
                "status"
              ]
            }
          },
          {
            "name": "sortOrder",
            "required": false,
            "in": "query",
            "schema": {
              "default": "asc",
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            }
          },
          {
            "name": "q",
            "required": false,
            "in": "query",
            "description": "Free-text search across fullName, email, currentCompany and displayId",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "description": "Filter by status. Defaults to ALL (every status); pass a specific status to narrow.",
            "schema": {
              "default": "ALL",
              "type": "string",
              "enum": [
                "COLD",
                "WARM",
                "HOT",
                "PLACED",
                "ALL"
              ]
            }
          },
          {
            "name": "industry",
            "required": false,
            "in": "query",
            "description": "Filter by industry (contains, case-insensitive)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "roleType",
            "required": false,
            "in": "query",
            "description": "Filter by role type (contains, case-insensitive)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "country",
            "required": false,
            "in": "query",
            "description": "Filter by country (contains, case-insensitive)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "city",
            "required": false,
            "in": "query",
            "description": "Filter by city (contains, case-insensitive)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "currentCompany",
            "required": false,
            "in": "query",
            "description": "Filter by current company (contains, case-insensitive)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "currentPosition",
            "required": false,
            "in": "query",
            "description": "Filter by current position (contains, case-insensitive)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "yearsExperienceMin",
            "required": false,
            "in": "query",
            "description": "Minimum years of experience (inclusive)",
            "schema": {
              "minimum": 0,
              "type": "number"
            }
          },
          {
            "name": "yearsExperienceMax",
            "required": false,
            "in": "query",
            "description": "Maximum years of experience (inclusive)",
            "schema": {
              "minimum": 0,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated candidates",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedCandidatesEntity"
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "List candidates (paginated, filterable, sortable)",
        "tags": [
          "Candidates"
        ]
      },
