  "info": {
    "title": "Linktal Recruitment API",
    "description": "API for Linktal Recruitment OS",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "idToken": {
            "type": "string",
            "description": "Azure AD id_token from the web app's OAuth sign-in"
          }
        },
        "required": [
          "idToken"
        ]
      },
      "SessionUserEntity": {
        "type": "object",
        "properties": {
          "consultantId": {
            "type": "string"
          },
          "email": {
            "type": "object"
          },
          "fullName": {
            "type": "string"
          },
          "roleName": {
            "type": "string",
            "nullable": true
          },
          "permissions": {
            "description": "Flat 'resource:action' strings",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "consultantId",
          "email",
          "fullName",
          "roleName",
          "permissions"
        ]
      },
      "LoginResponseEntity": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "accessTokenExpiresAt": {
            "type": "number",
            "description": "Epoch ms"
          },
          "refreshToken": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/SessionUserEntity"
          }
        },
        "required": [
          "accessToken",
          "accessTokenExpiresAt",
          "refreshToken",
          "user"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 8
          },
          "fullName": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password",
          "fullName"
        ]
      },
      "PasswordLoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "Refresh token issued by POST /auth/login"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "RefreshResponseEntity": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "accessTokenExpiresAt": {
            "type": "number",
            "description": "Epoch ms"
          },
          "user": {
            "$ref": "#/components/schemas/SessionUserEntity"
          }
        },
        "required": [
