# --- Neon PostgreSQL ---
# Pooled connection (used by the app at runtime). Include ?sslmode=require&pgbouncer=true
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require&pgbouncer=true"
# Direct (unpooled) connection — used by Prisma Migrate. Omit pgbouncer.
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require"

# --- Server ---
PORT=3001
# Comma-separated list of allowed origins for CORS (the web app URL).
CORS_ORIGIN="http://localhost:3000"

# --- Auth (Azure AD id_token verification, at login only) ---
# From the Azure AD (Entra ID) app registration shared by the client.
AZURE_TENANT_ID="<tenant-guid>"
AZURE_CLIENT_ID="<app-registration-client-id>"

# --- Auth (our own API access/refresh tokens) ---
# Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET="..."
JWT_REFRESH_SECRET="..."

# --- File uploads (Cloudflare R2, S3-compatible) ---
# TOB documents, job order JD/ads/other docs, and candidate resumes upload
# here instead of storing a pasted link. The bucket stays private — nothing
# is served from a public R2 URL; reads go back through this API's own
# GET /uploads/view, permission-gated per owning entity. All four are
# required for POST/GET /uploads/* to work; the rest of the app runs fine
# without them. Cloudflare dashboard -> R2 -> Manage API tokens.
R2_ACCOUNT_ID="<cloudflare-account-id>"
R2_ACCESS_KEY_ID="<r2-access-key-id>"
R2_SECRET_ACCESS_KEY="<r2-secret-access-key>"
R2_BUCKET_NAME="<bucket-name>"
