# --- Neon PostgreSQL ---
# Pooled connection (used by the app at runtime). Include ?sslmode=require&pgbouncer=true
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require&pgbouncer=true"
# Direct (unpooled) connection — used by Prisma Migrate. Omit pgbouncer.
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require"

# --- Server ---
PORT=3001
# Comma-separated list of allowed origins for CORS (the web app URL).
CORS_ORIGIN="http://localhost:3000"

# --- Auth (Neon Auth JWT verification) ---
# Base URL of your Neon Auth instance (same value as the web app's
# NEON_AUTH_BASE_URL — note it includes a path like /<db>/auth). The API
# verifies incoming JWTs against `${BASE_URL}/.well-known/jwks.json`, with
# issuer/audience = the base URL's origin.
NEON_AUTH_BASE_URL="https://ep-xxxx.neonauth.region.aws.neon.tech/neondb/auth"
# Optional: override the full JWKS URL if it differs from the default above.
# NEON_AUTH_JWKS_URL="https://ep-xxxx.neonauth.region.aws.neon.tech/neondb/auth/.well-known/jwks.json"
